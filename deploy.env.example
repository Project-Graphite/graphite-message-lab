# Select the image produced by the GitHub Actions workflow. Use a full sha-<commit> tag for a deployment.
IMAGE_TAG=latest

# Application configuration
SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=false
ALLOWED_HOSTS=message-lab.project-graphite.com
WEB_CONCURRENCY=1

# Private Compose services. These values are examples and must be replaced before deployment.
POSTGRES_DB=graphite_message_lab
POSTGRES_USER=graphite_message_lab
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://graphite_message_lab:replace-with-a-random-password@postgres:5432/graphite_message_lab
REDIS_URL=redis://redis:6379/0
